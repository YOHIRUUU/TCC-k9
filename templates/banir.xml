<?xml version="1.0" encoding="UTF-8"?> <banir idioma="en">
<root>
    <conteudo>
        <formulario
            action="/banir"
            method="POST"
            enctype="multipart/form-data">
            <titulo id="titulo">
                Banir
            </titulo>
            <espaco />
            <selecao
                name="email_selecionado"
                aria-label="Default select example">
                <opcao
                    valor=""
                    selecionada="true"
                    desabilitada="true">
                    Escolha o Item
                </opcao>
                {% for item in registros %}
                <opcao
                    valor="{{ item.email }}">
                    {{ item.email }}
                </opcao>
                {% endfor %}
            </selecao>
            <acao id="Regiscao">
                <botao
                    type="submit"
                    classe="btn btn-danger">
                    Banir
                </botao>
            </acao>
        </formulario>
    </conteudo>
    </banir>
</root>
