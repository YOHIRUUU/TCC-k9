<?xml version="1.0" encoding="UTF-8"?> <movimentacao idioma="en">
<configuracao>

    <charset>UTF-8</charset>

    <viewport
        largura="device-width"
        escala-inicial="1.0" />

    <titulo>
        Adicionar Item
    </titulo>

    <bootstrap>

        <css>
            https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css
        </css>

        <javascript
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous">

            https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js

        </javascript>

    </bootstrap>

    <folha-estilo>
        ../static/style4.css
    </folha-estilo>

    <icone>
        static/senai.png
    </icone>

</configuracao>


<navbar
    id="navbar"
    classe="navbar navbar-expand-lg navbar-custom fixed-top">

    <logo href="/" id="logo">
        ../static/senai2.png
    </logo>


    <titulo id="tituloEstoque">
        Almoxarifado
    </titulo>


    <menu>

        {% if session.get('permisao') == 1 %}

        <item href="/cadastrar">
            Cadastrar
        </item>

        <item href="/adicionar">
            Adicionar
        </item>

        <item href="/remover">
            Remover
        </item>

        {% endif %}


        <item href="/historico">
            Historico
        </item>

        <item href="/ABRAXAS">
            Estoque
        </item>


        <configuracoes>

            <icone>
                ../static/manage.png
            </icone>


            <item href="/perfil">
                Perfil
            </item>


            {% if session.get('permisao') == 1 %}

            <item href="/usuarios">
                Usuários
            </item>

            <item href="/banir">
                Banir
            </item>

            <item href="/desbanir">
                Desbanir
            </item>

            <item href="/cadastrar">
                Cadastrar
            </item>

            {% endif %}


            <item href="/logout">
                Sair do Sistema
            </item>

            <item href="/deletar">
                Deletar conta
            </item>

        </configuracoes>

    </menu>

</navbar>


<conteudo>

    <formulario
        action="/movimentação"
        method="POST"
        enctype="multipart/form-data">

        <titulo id="titulo">
            Movimentação
        </titulo>


        <selecao
            classe="form-select"
            name="item_selecionado"
            aria-label="Default select example">

            <opcao
                valor=""
                selecionada="true"
                desabilitada="true">

                Escolha o Item

            </opcao>


            {% for item in registros %}

            <opcao
                valor="{{ item.id }}">

                {{ item.nome }}

            </opcao>

            {% endfor %}

        </selecao>


        <campo>

            <label>
                Quantidade
            </label>

            <input
                type="number"
                min="0"
                name="Quantidade"
                classe="form-control"
                id="inputAddress2" />

        </campo>


        <opcao-movimentacao>

            <radio
                type="radio"
                name="opcao"
                id="radioDefault1"
                valor="add"
                selecionado="true" />

            <label
                for="Adicionar Itens">

                Adicionar Itens

            </label>

        </opcao-movimentacao>


        <opcao-movimentacao>

            <radio
                type="radio"
                name="opcao"
                id="radioDefault2"
                valor="rmv" />

            <label
                for="Retirar Itens">

                Retirar Itens

            </label>

        </opcao-movimentacao>


        <acao id="Regiscao">

            <botao
                type="submit"
                classe="btn btn-primary">

                Registrar Mudança

            </botao>

        </acao>

    </formulario>

</conteudo>

</movimentacao>