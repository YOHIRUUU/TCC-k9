<?xml version="1.0" encoding="UTF-8"?> <movimentacao idioma="en">
<root>
    <conteudo>
        <formulario
            action="/movimentação"
            method="POST"
            enctype="multipart/form-data">
            <titulo id="titulo">
                Movimentação
            </titulo>
            <selecao
                classe="form-select"
                name="item_selecionado"
                aria-label="Default select example">
                <opcao
                    valor=""
                    selecionada="true"
                    desabilitada="true">
                    Escolha o Item
                </opcao>
                {% for item in registros %}
                <opcao
                    valor="{{ item.id }}">
                    {{ item.nome }}
                </opcao>
                {% endfor %}
            </selecao>
            <campo>
                <label>
                    Quantidade
                </label>
                <input
                    type="number"
                    min="0"
                    name="Quantidade"
                    classe="form-control"
                    id="inputAddress2" />
            </campo>
            <opcao-movimentacao>
                <radio
                    type="radio"
                    name="opcao"
                    id="radioDefault1"
                    valor="add"
                    selecionado="true" />
                <label
                    for="Adicionar Itens">
                    Adicionar Itens
                </label>
            </opcao-movimentacao>
            <opcao-movimentacao>
                <radio
                    type="radio"
                    name="opcao"
                    id="radioDefault2"
                    valor="rmv" />
                <label
                    for="Retirar Itens">
                    Retirar Itens
                </label>
            </opcao-movimentacao>
            <acao id="Regiscao">
                <botao
                    type="submit"
                    classe="btn btn-primary">
                    Registrar Mudança
                </botao>
            </acao>
        </formulario>
    </conteudo>
    </movimentacao>
</root>
