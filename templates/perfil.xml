<?xml version="1.0" encoding="UTF-8"?> <usuarios idioma="en">
<root>
    <perfil id="flex">
        <cartao id="cardfx">
            <foto id="divesquerda">
                <imagem
                    src="../static/userimagem.png"
                    id="fotouser"
                    alt="foto do user" />
            </foto>
            <informacoes id="divdireita">
                <cabecalho id="divdircima">
                    {% for item in registro %}
                    <nome>
                        {{ item.nome }}
                    </nome>
                    <email>
                        {{ item.email }}
                    </email>
                    {% if item.permisao == 1 %}
                    <permissao>
                        administrador
                    </permissao>
                    {% endif %}
                    {% if item.permisao == 0 %}
                    <permissao>
                        usuário
                    </permissao>
                    {% endif %}
                    {% endfor %}
                </cabecalho>
                <acoes id="divdirbaixo">
                    <botao id="botaev2">
                        <link href="/logout">
                            <imagem
                                src="../static/account_circle.png" />
                        </link>
                    </botao>
                    <botao id="botaev2">
                        <link href="/banido">
                            Deletar Conta
                        </link>
                    </botao>
                </acoes>
            </informacoes>
        </cartao>
    </perfil>
    <movimentacoes id="elemento">
        <cartao id="card">
            <tabela id="tabela">
                <registros>
                    {% for item in registros %}
                    <registro>
                        <id_log>
                            {{ item.id_log }}
                        </id_log>
                        <acao>
                            <texto>
                                {{ item.acao }}
                            </texto>
                            <classe>
                                {% if 'Entrada' in item.acao %}
                                    bg-success
                                {% elif 'Novo' in item.acao %}
                                    bg-primary
                                {% elif 'Saída' in item.acao %}
                                    bg-warning
                                {% elif 'Deletado' in item.acao %}
                                    bg-danger
                                {% else %}
                                    bg-secondary
                                {% endif %}
                            </classe>
                        </acao>
                        <produto>
                            {{ item.produto_nome }}
                        </produto>
                        <quantidade_anterior>
                            {{ item.qtd_anterior }}
                            un.
                        </quantidade_anterior>
                        <quantidade_nova>
                            {{ item.qtd_nova }}
                            un.
                        </quantidade_nova>
                        <data_hora>
                            {{ item.data_hora }}
                        </data_hora>
                    </registro>
                    {% else %}
                    <sem-registros>
                        <mensagem>
                            Nenhuma movimentação registrada ainda.
                        </mensagem>
                    </sem-registros>
                    {% endfor %}
                </registros>
            </tabela>
        </cartao>
    </movimentacoes>
    </usuarios>
</root>
