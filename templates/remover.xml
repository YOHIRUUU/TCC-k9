<?xml version="1.0" encoding="UTF-8"?> <remover-item idioma="en">
<root>
    <conteudo>
        <formulario
            action="/remover"
            method="POST"
            enctype="multipart/form-data">
            <titulo id="titulo">
                Remover
            </titulo>
            <selecao
                classe="form-select"
                name="item_selecionado"
                aria-label="Default select example">
                <opcao
                    valor=""
                    selecionada="true"
                    desabilitada="true">
                    Escolha o Item
                </opcao>
                {% for item in registros %}
                <opcao
                    valor="{{ item.id }}">
                    {{ item.nome }}
                </opcao>
                {% endfor %}
            </selecao>
            <acao id="Regiscao">
                <botao
                    type="submit"
                    classe="btn btn-primary">
                    Deletar
                </botao>
            </acao>
        </formulario>
    </conteudo>
    </remover-item>
</root>
