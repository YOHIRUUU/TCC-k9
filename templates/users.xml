<?xml version="1.0" encoding="UTF-8"?> <usuarios idioma="en">
<configuracao>

    <charset>UTF-8</charset>

    <viewport
        largura="device-width"
        escala-inicial="1.0" />

    <titulo>
        usuarios
    </titulo>

    <bootstrap>

        <css>
            https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css
        </css>

        <javascript
            integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
            crossorigin="anonymous">

            https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js

        </javascript>

    </bootstrap>

    <sweetalert>

        <css>
            https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.min.css
        </css>

        <javascript>
            https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js
        </javascript>

    </sweetalert>

    <folha-estilo>
        ../static/style4.css
    </folha-estilo>

    <icone>
        static/senai.png
    </icone>

</configuracao>


<navbar
    id="navbar"
    classe="navbar navbar-expand-lg navbar-custom fixed-top">

    <logo
        href="/"
        id="logo">

        ../static/senai2.png

    </logo>


    <titulo id="tituloEstoque">
        Almoxarifado
    </titulo>


    <menu>

        <item href="/cadastrar">
            Cadastrar
        </item>

        <item href="/banir">
            Banir
        </item>

        <item href="/desbanir">
            Desbanir
        </item>

        <item href="/perfil">
            Perfil
        </item>

        <item href="/logout">
            Logout
        </item>

        <item href="/delete">
            Deletar conta
        </item>


        <configuracoes>

            <icone>
                ../static/usericon.png
            </icone>


            <item href="/ABRAXAS">
                Estoque
            </item>

            <item href="/adicionar">
                Adicionar
            </item>

            <item href="/remover">
                Remover
            </item>

            <item href="movimentação">
                Movimentar
            </item>

            <item href="/historico">
                Histórico
            </item>

        </configuracoes>

    </menu>

</navbar>


<usuarios-lista id="flex">

    {% for item in registros %}

    <usuario id="subflex">

        <cartao id="cardfx">

            <foto id="divesquerda">

                <imagem
                    src="../static/userimagem.png"
                    id="fotouser"
                    alt="foto do user" />

            </foto>


            <informacoes id="divdireita">

                <dados id="divdircima">

                    <nome>
                        {{ item.nome }}
                    </nome>


                    <email>
                        {{ item.email }}
                    </email>


                    {% if item.permisao == 1 %}

                    <permissao>
                        administrador
                    </permissao>

                    {% endif %}


                    {% if item.permisao == 0 %}

                    <permissao>
                        usuário
                    </permissao>

                    {% endif %}


                    {% if item.validade == 1 %}

                    <status>
                        BANIDO
                    </status>

                    {% endif %}

                </dados>

            </informacoes>

        </cartao>

    </usuario>

    {% endfor %}

</usuarios-lista>

</usuarios>